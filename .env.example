# =========================================================================
# CYBER MAFIA — Environment Variables Configuration
# Copy this file to .env (for local dev) or configure in Vercel Project Settings
# NEVER commit your actual .env file or credentials to Git.
# =========================================================================

# --- SUPABASE BACKEND (Serverless APIs & Authoritative Game Service) ---
# Project URL (Supabase Dashboard -> Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Secret Key (Privileged server-side ONLY)
# Used by Vercel serverless functions to perform authoritative writes and state mutations.
# CAUTION: NEVER expose this key to browser bundles, client code, or prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- SUPABASE FRONTEND (Browser & Realtime Subscriptions) ---
# Public URL accessible from client browser
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (safe for public Realtime subscriptions with RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- ADMINISTRATIVE SECURITY ---
# Secret key required in x-admin-key header for admin operations (Start, Pause, Resume, End, Snapshot Restore, Level Reset, CSV Export)
# Choose a strong secret (at least 16 characters recommended)
ADMIN_SECRET_KEY=your-secure-random-admin-secret-key

# --- DATABASE ADAPTER CONTROL ---
# Set to 'false' (default) to require live Supabase PostgreSQL.
# Set to 'true' only to run offline unit tests with in-memory storage.
CYBER_MAFIA_USE_MOCK_DB=false

# --- LOCAL DEVELOPMENT SETTINGS ---
NODE_ENV=development
PORT=3001
