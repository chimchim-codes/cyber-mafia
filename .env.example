# =========================================================================
# CYBER MAFIA — Environment Variables Configuration
# Copy this file to .env (for local dev) or set in Vercel / Supabase Project Settings
# =========================================================================

# --- SUPABASE CONFIGURATION ---
# Public URL for your Supabase project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (safe for browser and public subscriptions)
SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Secret Key (Privileged server-side ONLY. NEVER expose to client or prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- ADMINISTRATIVE SECURITY ---
# Secret key required in x-admin-key header for administrative operations (Recovery, Reset, CSV Export)
ADMIN_SECRET_KEY=cyber-mafia-admin-secret-replace-in-production

# --- ENVIRONMENT & PORT (Local Development) ---
NODE_ENV=development
PORT=3001
