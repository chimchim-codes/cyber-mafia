# =========================================================================
# SupportHub — Real-Time AI Customer Support Chatbot
# Copy this file to .env for local configuration
# =========================================================================

# Server Port
PORT=5001
NODE_ENV=development

# MongoDB Connection String (Atlas or local)
# Leave empty or omit to automatically launch the embedded In-Memory MongoDB Server (zero-config local demo)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/supporthub?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=supporthub_super_secret_jwt_key_2026_secure
JWT_EXPIRES_IN=7d

# OpenAI API Integration
# When provided, SupportHub AI queries OpenAI with conversation history and verified FAQs
# When omitted or rate limited, the chatbot automatically falls back to its intelligent FAQ & empathy engine
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Frontend Environment (client/.env)
VITE_API_URL=http://localhost:5001
